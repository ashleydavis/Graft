// The app's details, which Ziggy's build reads: its name, which names its log files, its title, which heads them, and its splash
// screen, shown while the frontend loads.
.{
    .name = "graft",
    .title = "Graft",
    .splash = .{
        .background = "#14171A",
        .portrait = "assets/splash-portrait.png",
        .landscape = "assets/splash-landscape.png",
        // Red where the splash and the web view leave the window uncovered, and a blue menu cover, so a splash recording shows any
        // uncovered frame and where the menu cover is as it fades.
        .window_background = "#FF0000",
        .menu_cover = "#0000FF",
    },
}
