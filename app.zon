// The app's details, which Ziggy's build reads: its name, which names its log files, its title, which heads them, and its splash
// screen, shown while the frontend loads.
.{
    .name = "graft",
    .title = "Graft",
    .splash = .{
        .background = "#14171A",
        .portrait = "assets/splash-portrait.png",
        .landscape = "assets/splash-landscape.png",
        // The splash background where the splash and the web view leave the window uncovered, and under the menu bar until the
        // splash fades, so neither shows as a colour of its own.
        .window_background = "#14171A",
        .menu_cover = "#14171A",
    },
}
