{
    "include": ["frontend/**/*", "vite.config.ts"],
    "exclude": ["node_modules", "build", "dist"],
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "rootDir": ".",
        "moduleResolution": "bundler",
        "outDir": "./build",
        "noEmit": true,
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true
    }
}
